{
  "name": "dnshe-panel",
  "version": "1.0.0",
  "description": "DNSHE Multi-Account Domain Manager Cloudflare Worker",
  "main": "src/index.ts",
  "scripts": {
    "clean:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/clean-local.ps1 -Force",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:node": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --external:cloudflare:sockets --outfile=dist-node/server.mjs",
    "start:node": "node dist-node/server.mjs",
    "verify:node": "tsc --noEmit -p server",
    "test:node": "esbuild server/d1-sqlite.test.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-node/d1-sqlite.test.mjs && node dist-node/d1-sqlite.test.mjs",
    "test:local-kv": "esbuild server/local-kv.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist-node/local-kv.mjs && node scripts/test-local-kv.mjs",
    "test:pages": "node scripts/test-pages-demo.mjs",
    "test:quota": "node scripts/test-cf-quota-model.mjs",
    "test:overview": "node scripts/test-overview-cf-model.mjs",
    "test:overview:layout": "node scripts/test-overview-context-layout.mjs",
    "test:usage:backend": "node scripts/test-cf-usage-backend.mjs",
    "test:cf:permissions": "node scripts/test-cf-permissions.mjs",
    "test:delegate:cf": "node scripts/test-delegate-cloudflare-backend.mjs",
    "test:renewal:rules": "node scripts/test-renewal-rules.mjs",
    "test:cf:diagnostics": "node scripts/test-cf-diagnostics-ui.mjs",
    "test:preview": "node scripts/test-preview-boundaries.mjs",
    "test:auth:logs": "node scripts/test-auth-logs.mjs",
    "test:accounts:binding": "node scripts/test-account-binding-errors.mjs",
    "test:review:session": "node scripts/test-review-session.mjs",
    "test:quota:ui": "node scripts/test-cf-quota-ui.mjs",
    "test:style:ui": "node scripts/test-interface-style-ui.mjs",
    "test:apikey:ui": "node scripts/test-api-key-inspector.mjs",
    "test:apikey:surface": "node scripts/test-key-surface-blending.mjs",
    "test:register-ddns:ui": "node scripts/test-register-ddns-ui.mjs",
    "test:ddns:cards:ui": "node scripts/test-ddns-cards-ui.mjs",
    "test:flows:ui": "node scripts/test-flow-workspaces-ui.mjs",
    "test:preview:session:ui": "node scripts/test-preview-session-ui.mjs",
    "test:logs:ui": "node scripts/test-logs-refresh.mjs",
    "test:asset:layout": "node scripts/test-asset-layout.mjs",
    "test:editorial:ui": "node scripts/test-editorial-workspaces.mjs",
    "test:asset:evidence": "node scripts/test-asset-state-evidence.mjs",
    "test:domain-check:cache": "node scripts/test-domain-check-cache.mjs",
    "test:feedback:modules": "node scripts/test-feedback-summary-modules.mjs",
    "test:feedback:refinements": "node scripts/test-feedback-refinements-ui.mjs",
    "review:design": "node scripts/design-review.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "miniflare": "5.20260826.0-alpha",
    "playwright": "1.59.1",
    "typescript": "^5.4.3",
    "wrangler": "^4.127.0"
  }
}
